{
  "rewrites": [
    {
      "source": "/i/:code",
      "destination": "/i.html"
    },
    {
      "source": "/supprimer-compte",
      "destination": "/supprimer-compte.html"
    },
    {
      "source": "/ambassadeurs",
      "destination": "/ambassadeurs.html"
    },
    {
      "source": "/villes",
      "destination": "/api/villes"
    },
    {
      "source": "/sitemap-villes.xml",
      "destination": "/api/sitemap-villes"
    },
    {
      "source": "/sitemap-contenus.xml",
      "destination": "/api/sitemap-contenus"
    },
    {
      "source": "/villes/:slug",
      "destination": "/api/ville?slug=:slug"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/mairies",
      "destination": "/mairies.html"
    },
    {
      "source": "/commercants",
      "destination": "/commercants.html"
    },
    {
      "source": "/artisans",
      "destination": "/artisans.html"
    },
    {
      "source": "/agences",
      "destination": "/agences.html"
    },
    {
      "source": "/courtiers",
      "destination": "/courtiers.html"
    },
    {
      "source": "/loisirs",
      "destination": "/loisirs.html"
    },
    {
      "source": "/idees-sorties",
      "destination": "/idees-sorties.html"
    },
    {
      "source": "/proposer-un-evenement",
      "destination": "/proposer-un-evenement.html"
    },
    {
      "source": "/appels-offres",
      "destination": "/appels-offres.html"
    },
    {
      "source": "/tarifs",
      "destination": "/tarifs.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/mentions-legales",
      "destination": "/mentions-legales.html"
    },
    {
      "source": "/cgv",
      "destination": "/cgv.html"
    },
    {
      "source": "/cgu",
      "destination": "/cgu.html"
    },
    {
      "source": "/confidentialite",
      "destination": "/confidentialite.html"
    },
    {
      "source": "/cookies",
      "destination": "/cookies.html"
    },
    {
      "source": "/paiement/ok",
      "destination": "/paiement-ok.html"
    },
    {
      "source": "/paiement/annule",
      "destination": "/paiement-annule.html"
    },
    {
      "source": "/contact/",
      "destination": "/contact.html"
    },
    {
      "source": "/contact/:path*",
      "destination": "/contact.html"
    },
    {
      "source": "/devis/:token",
      "destination": "/devis.html"
    },
    {
      "source": "/annonce/:id",
      "destination": "/api/annonce?id=:id"
    },
    {
      "source": "/hebergement/:slug",
      "destination": "/api/hebergement?slug=:slug"
    },
    {
      "source": "/pro/:id",
      "destination": "/api/pro?id=:id"
    },
    {
      "source": "/artisan/:id",
      "destination": "/api/artisan?id=:id"
    },
    {
      "source": "/sortie/:id",
      "destination": "/api/sortie?id=:id"
    },
    {
      "source": "/offre/:id",
      "destination": "/api/offre?id=:id"
    },
    {
      "source": "/actu/:id",
      "destination": "/api/actu?id=:id"
    },
    {
      "source": "/agence/:id",
      "destination": "/api/agence?id=:id"
    },
    {
      "source": "/courtier/:id",
      "destination": "/api/courtier?id=:id"
    },
    {
      "source": "/mairie/:id.ics",
      "destination": "/api/mairie?id=:id&format=ics"
    },
    {
      "source": "/mairie/:id",
      "destination": "/api/mairie?id=:id"
    },
    {
      "source": "/evenement/:id.ics",
      "destination": "/api/evenement?id=:id&format=ics"
    },
    {
      "source": "/evenement/:id",
      "destination": "/api/evenement?id=:id"
    },
    {
      "source": "/contrats/:token",
      "destination": "/signer-contrat.html"
    },
    {
      "source": "/deposer-projet",
      "destination": "/deposer-projet.html"
    },
    {
      "source": "/mes-projets",
      "destination": "/mes-projets.html"
    },
    {
      "source": "/paiement/evenement-ok",
      "destination": "/paiement-evenement-ok.html"
    }
  ],
  "headers": [
    {
      "source": "/signer-contrat.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://lokalist-api-production.up.railway.app; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    },
    {
      "source": "/contrats/:path*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), payment=()"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://lokalist-api-production.up.railway.app; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self';"
        }
      ]
    }
  ]
}
